# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Danh sách và ý nghĩa: docs/01 mục 14.

# --- Database (Neon). DATABASE_URL = bản pooled, DIRECT_URL = bản trực tiếp để chạy migration ---
DATABASE_URL="postgresql://user:password@localhost:5432/lamora"
DIRECT_URL="postgresql://user:password@localhost:5432/lamora"

# --- Bí mật (mỗi biến ≥ 32 ký tự ngẫu nhiên; tạo bằng: openssl rand -base64 32) ---
AUTH_SECRET=""
IP_HASH_SALT=""
CRON_SECRET=""

# --- Website ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Chỉ dùng khi seed tài khoản admin (đổi mật khẩu ngay sau lần đăng nhập đầu) ---
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# --- Cloudinary (upload ảnh) - bật ở bước B4 ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Telegram (báo đơn mới) - bật ở bước C7. Để false khi chạy local/preview ---
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- VietQR (chuyển khoản) - bật ở bước C5 ---
BANK_BIN=""
BANK_ACCOUNT_NO=""
BANK_ACCOUNT_NAME=""
